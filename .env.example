# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Postgres connection string. Leave empty to use embedded PGlite at .pglite/dev.
DATABASE_URL=
# Select-only role for the web app, MCP server and ingest:report (scripts/db/roles.sql). Falls back to DATABASE_URL.
DATABASE_URL_READONLY=
# Max connections in the pg pool (ignored for PGlite).
DB_POOL_MAX=
# Millisecond limits, empty = default. 0 disables a timeout. Documented in docs/OPERATIONS.md.
DB_STATEMENT_TIMEOUT_MS=
INGEST_DB_STATEMENT_TIMEOUT_MS=
DB_CONNECT_TIMEOUT_MS=
DB_IDLE_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
DB_IDLE_IN_TX_TIMEOUT_MS=
# Ingest shrink guard (docs/INGEST.md): 0..1 fractions and a record-count baseline.
INGEST_MAX_DELETE_FRACTION=
INGEST_MIN_RECORD_RATIO=
INGEST_MIN_RECORD_BASELINE=
CONGRESS_GOV_API_KEY=
FEC_API_KEY=
OPENSTATES_API_KEY=
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=
# Public API (apps/web). Header your proxy sets to the client IP; unset = all callers share one rate-limit bucket.
# Required in production (NODE_ENV=production) unless RATE_LIMIT_SINGLE_BUCKET=1.
TRUSTED_PROXY_HEADER=
# Set to 1 to accept that, without a trusted header, every caller shares one rate-limit bucket.
RATE_LIMIT_SINGLE_BUCKET=
PAGE_RATE_LIMIT_PER_MINUTE=
# For x-forwarded-for: which entry from the right is the client.
TRUSTED_PROXY_HOPS=
API_RATE_LIMIT_PER_MINUTE=
API_RATE_LIMIT_EVALUATE_PER_MINUTE=
API_RATE_LIMIT_HEALTH_PER_MINUTE=
HEALTH_DB_TIMEOUT_MS=
HEALTH_MAX_INGEST_AGE_HOURS=
