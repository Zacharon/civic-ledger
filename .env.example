# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Postgres connection string. Leave empty to use embedded PGlite at .pglite/dev.
DATABASE_URL=
# Max connections in the pg pool (ignored for PGlite).
DB_POOL_MAX=
CONGRESS_GOV_API_KEY=
FEC_API_KEY=
OPENSTATES_API_KEY=
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=
# Public API (apps/web). Header your proxy sets to the client IP; unset = all callers share one rate-limit bucket.
TRUSTED_PROXY_HEADER=
# For x-forwarded-for: which entry from the right is the client.
TRUSTED_PROXY_HOPS=
API_RATE_LIMIT_PER_MINUTE=
API_RATE_LIMIT_EVALUATE_PER_MINUTE=
API_RATE_LIMIT_HEALTH_PER_MINUTE=
HEALTH_DB_TIMEOUT_MS=
HEALTH_MAX_INGEST_AGE_HOURS=
